# Blinkit Growth Discovery Engine Configuration Template

# Primary Provider (Options: cloudflare, groq, openrouter)
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI Credentials & Model
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Secondary Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary Provider: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Pipeline Processing Configuration
DEFAULT_LIMIT=200
DEFAULT_BATCH_SIZE_FILTER=10
DEFAULT_BATCH_SIZE_ANALYZE=5
